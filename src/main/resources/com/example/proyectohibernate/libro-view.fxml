<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectohibernate.controller.LibroController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="510.0" prefWidth="710.0" spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Gestión de libros - Hibernate ORM" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" prefHeight="127.0" prefWidth="381.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="100.0" prefWidth="110.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="580.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Título:" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtTitulo" prefHeight="26.0" prefWidth="260.0" promptText="Título del libro" GridPane.columnIndex="1" />

                        <Label text="Autor:" textFill="#34495e" GridPane.rowIndex="1">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtAutor" promptText="Autor del libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Año de publicación:" textFill="#34495e" GridPane.rowIndex="2">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtAnio" prefHeight="26.0" prefWidth="288.0" promptText="Año de publicación" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Precio:" textFill="#34495e" GridPane.rowIndex="3">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtPrecio" prefHeight="26.0" prefWidth="315.0" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarLibro" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Guardar libro">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#modificarLibro" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" text="Modificar libro">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarLibro" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;" text="Eliminar libro">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#cargarLibros" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-cursor: hand;" text="Cargar libros">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar campos">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Label text="Seleccione un libro de la tabla para modificarlo o eliminarlo." textFill="#7f8c8d">
                    <font>
                        <Font name="System Italic" size="11.0" />
                    </font>
                </Label>

                <TableView fx:id="tableLibros" prefHeight="220.0" prefWidth="710.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />
                        <TableColumn fx:id="colAutor" prefWidth="200.0" text="Autor" />
                        <TableColumn fx:id="colAnio" prefWidth="90.0" text="Año" />
                        <TableColumn fx:id="colPrecio" prefWidth="108.0" text="Precio" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
